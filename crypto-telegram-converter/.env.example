# Dapatkan dari BotFather di Telegram.
TELEGRAM_BOT_TOKEN=123456789:isi_token_bot_telegram_kamu

# Opsional. Bot akan mencoba semua endpoint ini secara berurutan.
# Jika VPS kena HTTP 451 dari Binance, coba taruh data-api di urutan pertama.
# BINANCE_API_BASES=https://data-api.binance.vision,https://api.binance.com,https://api1.binance.com,https://api2.binance.com,https://api3.binance.com,https://api4.binance.com

# Opsional untuk /gas. Jika tidak diisi, bot memakai public Ethereum RPC.
# ETHERSCAN_API_KEY=isi_api_key_etherscan
# ETH_RPC_URLS=https://ethereum.publicnode.com,https://rpc.flashbots.net,https://cloudflare-eth.com

# Wajib untuk fitur floor price NFT OpenSea.
# Buat API key di https://docs.opensea.io/ lalu isi di bawah ini.
# OPENSEA_API_KEY=isi_api_key_opensea

# Opsional untuk alias nama collection OpenSea.
# Format: alias=slug-opensea,alias-lain=slug-lain
# OPENSEA_COLLECTION_ALIASES=axi-eternals=axi-eternals-616633974
